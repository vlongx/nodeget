# Required: point this DNS name to the server before starting Caddy.
DOMAIN=nodeget.example.com

# Optional but recommended for Let's Encrypt account notices.
ACME_EMAIL=admin@example.com

# NodeGet Server
NODEGET_IMAGE=GenshinMinecraft/NodeGet:latest
NODEGET_PORT=2211
NODEGET_LOG_FILTER=info
NODEGET_SERVER_UUID=

# Postgres
POSTGRES_DB=nodeget
POSTGRES_USER=nodeget
POSTGRES_PASSWORD=change-this-postgres-password

# Frontend prebuilt images. Default install pulls these images instead of building on the VPS.
BOARD_IMAGE=ghcr.io/eeviriyi/nodeget-board:main
STATUSSHOW_IMAGE=ghcr.io/eeviriyi/nodeget-statusshow:main

# Frontend source refs. Only used with docker-compose.build.yml.
BOARD_REPO=https://github.com/NodeSeekDev/NodeGet-board.git
BOARD_REF=main
STATUSSHOW_REPO=https://github.com/NodeSeekDev/NodeGet-StatusShow.git
STATUSSHOW_REF=main

# StatusShow config. Fill STATUS_TOKEN after creating a public/read-only token.
STATUS_SITE_NAME="NodeGet Status"
STATUS_SITE_LOGO=
STATUS_SITE_FOOTER="Powered by NodeGet"
STATUS_BACKEND_NAME=main
STATUS_BACKEND_URL=wss://nodeget.example.com/ws
STATUS_TOKEN=
